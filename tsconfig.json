{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@castor-bio/core": ["./packages/core/src/index.ts"],
      "@castor-bio/core/*": ["./packages/core/src/*"],
      "@castor-bio/catalog": ["./packages/catalog/src/index.ts"],
      "@castor-bio/react": ["./packages/react/src/index.ts"],
      "@castor-bio/mui": ["./packages/mui/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/scripts/**/*",
    "packages/react/vitest.setup.ts",
    "tools/*/src/**/*",
    "apps/*/src/**/*"
  ]
}
