{
  "name": "@castor-bio/react",
  "version": "0.1.0",
  "description": "React components for designing AAV transfer plasmids and comparing them gggenomes-style.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compare": {
      "import": {
        "types": "./dist/compare/index.d.mts",
        "default": "./dist/compare/index.mjs"
      },
      "require": {
        "types": "./dist/compare/index.d.cts",
        "default": "./dist/compare/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown && cp src/styles/castor.css dist/styles.css"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@castor-bio/core": "workspace:^",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "seqviz": "^3.10.24",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "typesVersions": {
    "*": {
      "compare": [
        "./dist/compare/index.d.cts"
      ]
    }
  }
}
