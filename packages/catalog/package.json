{
  "name": "@castor-bio/catalog",
  "version": "0.1.0",
  "description": "Curated AAV part, backbone and cassette-template catalogue.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "data",
    "schema"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/*": "./data/*",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "validate": "node --experimental-strip-types ./scripts/validate.ts"
  },
  "dependencies": {
    "@castor-bio/core": "workspace:^"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
