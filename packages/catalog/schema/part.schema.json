{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castor-bio.dev/schema/part.schema.json",
  "title": "AAV Designer part collection",
  "type": "object",
  "required": ["collection", "parts"],
  "properties": {
    "$schema": { "type": "string" },
    "collection": { "type": "string" },
    "version": { "type": "string" },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } }
  },
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "sequence",
        "length",
        "checksum",
        "attributes",
        "provenance",
        "license",
        "version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_]+/[A-Za-z0-9._+()-]+@\\d+\\.\\d+\\.\\d+$" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "role": {
          "enum": [
            "backbone",
            "itr",
            "spacer",
            "enhancer",
            "promoter",
            "switch",
            "intron",
            "utr5",
            "kozak",
            "signal_peptide",
            "tag",
            "linker",
            "cds",
            "joiner",
            "stop",
            "utr3",
            "wpre",
            "polya",
            "stuffer",
            "shrna",
            "amirna_scaffold",
            "grna_scaffold",
            "terminator",
            "custom"
          ]
        },
        "composition": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["partId", "strand"],
            "properties": {
              "partId": { "type": "string" },
              "strand": { "enum": [1, -1] }
            },
            "additionalProperties": false
          }
        },
        "sequence": { "type": "string", "pattern": "^[ACGTURYSWKMBDHVN]*$" },
        "length": { "type": "integer", "minimum": 0 },
        "checksum": { "type": "string", "pattern": "^sha1:[0-9a-f]{40}$" },
        "attributes": { "$ref": "#/$defs/attributes" },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string" },
        "variantOf": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "license": { "$ref": "#/$defs/license" }
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "polymerase": { "enum": ["II", "III"] },
        "strength": { "enum": ["weak", "medium", "strong", "adequate"] },
        "minimal": { "type": "boolean" },
        "tissue": { "type": "array", "items": { "type": "string" } },
        "species": { "type": "array", "items": { "type": "string" } },
        "silencingProne": { "type": "boolean" },
        "requiresMinimalPromoter": { "type": "boolean" },
        "pairsWith": { "type": "array", "items": { "type": "string" } },
        "cellType": { "type": "array", "items": { "type": "string" } },
        "serotype": { "enum": ["AAV2", "AAV5", "other"] },
        "form": { "enum": ["145", "130"] },
        "deltaTRS": { "type": "boolean" },
        "orientation": { "enum": ["flip", "flop"] },
        "rbeOffset": { "type": "integer", "minimum": 0 },
        "trsOffset": { "type": "integer", "minimum": 0 },
        "product": { "type": "string", "minLength": 1 },
        "hasStartCodon": { "type": "boolean" },
        "hasStopCodon": { "type": "boolean" },
        "nTermTaggable": { "type": "boolean" },
        "cTermTaggable": { "type": "boolean" },
        "uniprot": { "type": "string" },
        "fpbase": { "type": "string" },
        "mechanism": { "enum": ["2A", "IRES"] },
        "peptide": { "enum": ["P2A", "T2A", "E2A", "F2A"] },
        "needsGsgSpacer": { "type": "boolean" },
        "relativeEfficiency": { "type": "number", "minimum": 0, "maximum": 1 },
        "variant": { "enum": ["full", "WPRE3", "mut6"] },
        "xProteinOrf": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "system": { "enum": ["FLEX", "DIO", "LSL"] },
        "site": { "enum": ["loxP", "lox2272", "loxN", "FRT"] },
        "half": { "enum": ["5", "3"] },
        "pairKey": { "type": "string", "minLength": 1 },
        "terminus": { "enum": ["N", "C", "either"] },
        "copies": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "promoter" } }, "required": ["role"] },
          "then": { "required": ["polymerase"] }
        },
        {
          "if": { "properties": { "role": { "const": "itr" } }, "required": ["role"] },
          "then": { "required": ["serotype", "form", "deltaTRS", "orientation"] }
        },
        {
          "if": { "properties": { "role": { "const": "cds" } }, "required": ["role"] },
          "then": {
            "required": [
              "product",
              "hasStartCodon",
              "hasStopCodon",
              "nTermTaggable",
              "cTermTaggable"
            ]
          }
        },
        {
          "if": { "properties": { "role": { "const": "joiner" } }, "required": ["role"] },
          "then": { "required": ["mechanism", "needsGsgSpacer"] }
        },
        {
          "if": { "properties": { "role": { "const": "wpre" } }, "required": ["role"] },
          "then": { "required": ["variant", "xProteinOrf"] }
        },
        {
          "if": { "properties": { "role": { "const": "polya" } }, "required": ["role"] },
          "then": { "required": ["source"] }
        },
        {
          "if": { "properties": { "role": { "const": "switch" } }, "required": ["role"] },
          "then": { "required": ["system", "site", "half", "pairKey"] }
        },
        {
          "if": { "properties": { "role": { "const": "tag" } }, "required": ["role"] },
          "then": { "required": ["terminus", "copies"] }
        },
        {
          "if": { "properties": { "role": { "const": "terminator" } }, "required": ["role"] },
          "then": { "required": ["polymerase"], "properties": { "polymerase": { "const": "III" } } }
        }
      ]
    },
    "role": {
      "enum": [
        "backbone",
        "itr",
        "spacer",
        "enhancer",
        "promoter",
        "switch",
        "intron",
        "utr5",
        "kozak",
        "signal_peptide",
        "tag",
        "linker",
        "cds",
        "joiner",
        "stop",
        "utr3",
        "wpre",
        "polya",
        "stuffer",
        "shrna",
        "amirna_scaffold",
        "grna_scaffold",
        "terminator",
        "custom"
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "confidence"],
      "properties": {
        "origin": { "enum": ["curated", "user", "imported", "derived"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "curatedBy": { "type": "string" },
        "curatedAt": { "type": "string" },
        "note": { "type": "string" },
        "accessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["db", "id"],
            "properties": {
              "db": {
                "enum": ["GenBank", "ENA", "RefSeq", "UniProt", "FPbase", "iGEM", "SynBioHub"]
              },
              "id": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "addgene": {
          "type": "object",
          "required": ["plasmidId"],
          "properties": {
            "plasmidId": { "type": "integer" },
            "name": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "usages": { "type": "array", "items": { "$ref": "#/$defs/usage" } }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["kind", "title"],
      "properties": {
        "kind": { "enum": ["publication", "project", "repository"] },
        "title": { "type": "string" },
        "pmid": { "type": "string" },
        "pmcid": { "type": "string" },
        "doi": { "type": "string" },
        "year": { "type": "integer" },
        "journal": { "type": "string" },
        "authorsShort": { "type": "string" },
        "projectId": { "type": "string" },
        "owner": { "type": "string" },
        "team": { "type": "string" },
        "constructName": { "type": "string" },
        "url": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["spdx", "redistributable"],
      "properties": {
        "spdx": { "type": "string" },
        "redistributable": { "type": "boolean" },
        "source": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
